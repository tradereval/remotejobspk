generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String?
  phone          String?
  city           String?
  state          String?
  qualification  String?
  specialty      String?
  role            String         @default("user") // user | admin
  emailVerifiedAt DateTime?
  googleSub       String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscription    Subscription?
  savedJobs       SavedJob[]
  savedSearches   SavedSearch[]
  passwordResets  PasswordReset[]
  emailVerifications EmailVerification[]
  jobReports      JobReport[]
  payments        Payment[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               String    @default("inactive") // inactive | active | canceled | past_due
  plan                 String? // premium_pkr | premium_usd
  currency             String?
  safepayCustomerId    String?
  safepaySubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Job {
  id                String     @id @default(cuid())
  source            String // himalayas | manual
  externalId        String?
  title             String
  company           String
  companyLogo       String?
  description       String?
  excerpt           String?
  applicationUrl    String
  sourceAttributionUrl String?
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?
  salaryPeriod      String?
  employmentType    String? // Full-Time | Part-Time | Contractor | Freelance
  seniority         String?
  locationRestrictions String @default("[]") // JSON string[]
  timezoneRestrictions String @default("[]") // JSON number[] (UTC offsets)
  categories        String     @default("[]") // JSON array
  skills            String     @default("[]") // JSON array
  eligibility       String     @default("unknown") // pakistan | worldwide | restricted | unknown
  acceptsBeginners  Boolean    @default(false)
  isVerified        Boolean    @default(false)
  needsReview       Boolean    @default(true)
  publishedAt       DateTime?
  expiresAt         DateTime?
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  savedBy           SavedJob[]
  reports           JobReport[]

  @@unique([source, externalId])
  @@index([isActive, eligibility])
  @@index([isVerified])
  @@index([publishedAt])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String   @default("saved") // saved | applied
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model SavedSearch {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String?
  queryJson       String // JSON filters
  alertFrequency  String   @default("daily") // off | daily | instant
  lastAlertedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model JobReport {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  reason    String
  details   String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracker   String   @unique
  plan      String
  currency  String
  amount    Int
  status    String   @default("pending") // pending | paid | canceled | failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/** Always-on CRM log (works even when Google Sheet webhook is not configured). */
model LeadEvent {
  id                   String   @id @default(cuid())
  event                String
  userId               String?
  name                 String?
  email                String?
  phone                String?
  city                 String?
  state                String?
  qualification        String?
  specialty            String?
  plan                 String?
  subscriptionStatus   String?
  notes                String?
  sheetSynced          Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}
