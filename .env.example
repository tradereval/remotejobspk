AUTH_SECRET="generate-a-long-random-string"
ADMIN_EMAIL="admin@remotejobspk.com"
ADMIN_PASSWORD="change-me"
CRON_SECRET="generate-a-cron-secret"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="RemoteJobsPK"

# Optional Himalayas API key (higher rate limits)
# HIMALAYAS_API_KEY=""

# Safepay hosted checkout. Sandbox until the live merchant account is approved.
# SAFEPAY_ENV="sandbox"
# SAFEPAY_SECRET_KEY=""
# SAFEPAY_API_KEY=""
# SAFEPAY_INTENT="CYBERSOURCE"
# Webhook: POST {SITE}/api/payments/safepay  (we confirm the tracker with Safepay before granting Premium)
# Daily alerts: GET {SITE}/api/cron/alerts  Authorization: Bearer CRON_SECRET

# Resend (premium alerts)
# RESEND_API_KEY=""
# RESEND_FROM="RemoteJobsPK <noreply@remotejobspk.com>"

